---
/**
 * Contactpagina: één statement, daarna de harde gegevens (e-mail, adres,
 * KvK, btw) in dezelfde stijl als de rest van de site.
 */
import Base from '../layouts/Base.astro';
import { COMPANY } from '../data/company';
---
<Base
  title="Contact · Club Vanguard"
  description="Neem contact op met Club Vanguard. Vragen over lidmaatschap, events, partnerschappen of pers: mail ons, je hoort binnen twee werkdagen van ons."
>
  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__intro reveal">
        <p class="eyebrow">Contact</p>
        <h1 class="contact__title">Een mail is genoeg. Je hoort binnen twee werkdagen van ons.</h1>
        <p class="contact__text">
          Vragen over het lidmaatschap, een event, een samenwerking of pers?
          Mail ons rechtstreeks. Lid worden gaat via het aanvraagformulier,
          op de eventlijst komen via <a href="/join/">join</a>.
        </p> <a href={`mailto:${COMPANY.email}`} class="btn btn--solid contact__cta">Mail {COMPANY.email}</a>
      </div>

      <div class="contact__card reveal">
        <dl class="contact__details">
          <dt>E-mail</dt>
          <dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>

          <dt>Postadres</dt>
          <dd>
            {COMPANY.name}<br />
            {COMPANY.address.street}<br />
            {COMPANY.address.postal} {COMPANY.address.city}<br />
            {COMPANY.address.country}
          </dd>

          <dt>KvK-nummer</dt>
          <dd>{COMPANY.kvk}</dd>

          <dt>Btw-id</dt>
          <dd>{COMPANY.btw}</dd>

          <dt>Handelsnaam</dt>
          <dd>{COMPANY.name}</dd>
        </dl>
        <p class="contact__note">
          Het postadres is geen bezoekadres. Events vinden plaats op wisselende
          locaties in Nederland; de locatie staat altijd in de uitnodiging.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--ivory contact-links">
    <div class="container contact-links__grid"> <a href="/aanvragen/" class="contact-links__item">
        <h2>Lid worden</h2>
        <p>Dien je aanvraag in. We beoordelen elke aanvraag persoonlijk.</p>
      </a> <a href="/join/" class="contact-links__item">
        <h2>Eventlijst</h2>
        <p>Eén korte mail per week met de datums en vrije plekken.</p>
      </a> <a href="/meetups/" class="contact-links__item">
        <h2>Agenda</h2>
        <p>De club events, dinners en activiteiten van de komende maanden.</p>
      </a>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) minmax(300px, 1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .contact__title {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }
  .contact__text {
    margin-top: 1.4rem;
    color: var(--ivory-dim);
    max-width: 48ch;
  }
  .contact__text a { color: var(--brass-soft); }
  .contact__cta { margin-top: 2rem; text-transform: none; letter-spacing: 0.02em; }

  .contact__card {
    background: var(--navy-soft);
    border: 1px solid var(--line-navy);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .contact__details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.9rem 1.5rem;
    font-size: var(--text-sm);
  }
  .contact__details dt {
    color: var(--brass);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }
  .contact__details dd { color: var(--ivory); line-height: 1.6; }
  .contact__details a { color: var(--ivory); text-decoration: none; }
  .contact__details a:hover { color: var(--brass-soft); }
  .contact__note {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line-navy);
    font-size: var(--text-xs);
    color: var(--ivory-dim);
  }

  .contact-links__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .contact-links__item {
    display: block;
    padding: 1.75rem;
    border: 1px solid var(--line-ivory);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s, background 0.15s;
  }
  .contact-links__item:hover { border-color: var(--brass); background: rgba(255, 255, 255, 0.5); }
  .contact-links__item h2 { font-size: var(--text-lg); }
  .contact-links__item p {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--ink-dim);
  }

  @media (max-width: 800px) {
    .contact__grid,
    .contact-links__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .contact__details { grid-template-columns: 1fr; gap: 0.2rem; }
    .contact__details dt { margin-top: 0.8rem; }
  }
</style>
