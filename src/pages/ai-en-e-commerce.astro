---
/**
 * Vindbaarheidspagina (wave 1): "community ai ondernemers", "ai e-commerce netwerk", "ai in commerce".
 * Korte feitenzinnen in Misha's toon. Geen prijzen, geen andere clubs bij naam.
 */
import Base from '../layouts/Base.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { aiFaqs } from '../data/faq-seo';
import { faqSchema } from '../data/schema';
---
<Base
  title="AI en e-commerce: de community van ondernemers die het toepassen | Club Vanguard"
  description="Club Vanguard is de besloten club waar e-commerce- en retailondernemers en bouwers van AI-tools samenkomen. In de groepsapp delen leden dagelijks hoe ze AI inzetten, en twaalf keer per jaar zien we elkaar op een club event."
  image="/images/gallery-group.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema(aiFaqs))} />
  </Fragment>

  <section class="section seo-hero">
    <div class="container container--narrow">
      <p class="eyebrow">AI en e-commerce</p>
      <h1 class="seo-hero__title">AI in e‑commerce, <em>met mensen die het al doen.</em></h1>
      <p class="lead seo-hero__lead">
        Bij Club Vanguard zitten merkeigenaren en bouwers van AI-tools aan dezelfde tafel. Je hoort wat werkt in
        hun bedrijf, van content en klantenservice tot inkoop en forecasting. Dat delen ze dagelijks in de groepsapp,
        en twaalf keer per jaar zien we elkaar op een club event.
      </p>
      <a href="/aanvragen/" class="btn btn--solid">Start je aanvraag</a>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container split">
      <div class="split__content">
        <h2 class="section-title">Je leert van wat leden zelf bouwen.</h2>
        <p class="seo-text">
          Een deel van onze leden bouwt AI- en automatiseringstools, de rest gebruikt ze elke dag in hun webshop,
          op bol of op Amazon. Die mix maakt het gesprek praktisch. Je ziet wat iemand vorige maand heeft
          ingericht en wat het opleverde.
        </p>
      </div>
      <img src="/images/app.jpg" alt="Sessie over AI tijdens een Club Vanguard-event" class="site-photo split__photo" width="600" height="450" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="container split split--reverse">
      <img src="/images/gallery-6.jpg" alt="Leden van Club Vanguard aan het werk aan een lange tafel" class="site-photo split__photo" width="600" height="450" loading="lazy" />
      <div class="split__content">
        <h2 class="section-title">De groepsapp is waar het meeste gebeurt.</h2>
        <p class="seo-text seo-text--dim">
          Een prompt die werkt, een tool die tegenviel, een automatisering die uren scheelt. Het wordt gedeeld
          zodra het er is. Op de club events gaan we er samen dieper in.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container container--narrow">
      <h2 class="section-title">Lid worden begint met een gesprek.</h2>
      <p class="seo-text">
        Je stuurt een aanvraag in, daarna bellen we een halfuur over wat je bouwt en wat je zoekt.
      </p>
      <RelatedPages />
    </div>
  </section>

  <Faq items={aiFaqs} eyebrow="Veelgestelde vragen" title="Over AI en Vanguard" />
  <ClosingCta />
</Base>

<style>
  .seo-hero { background: var(--navy-deep); }
  .seo-hero__title { font-size: var(--text-display); line-height: 1.08; max-width: 18ch; }
  .seo-hero__title em { font-style: italic; color: var(--brass-soft); }
  .seo-hero__lead { margin: 1.6rem 0 2.2rem; max-width: 60ch; }
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .split--reverse .split__content { order: 1; }
  .split__photo { width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--line-ivory); object-fit: cover; aspect-ratio: 4 / 3; }
  .seo-text { margin-top: 1.4rem; color: var(--ink-dim); line-height: 1.7; font-size: var(--text-base); max-width: 58ch; }
  .seo-text--dim { color: var(--ivory-dim); }
  .seo-text a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .split { grid-template-columns: 1fr; }
    .split--reverse .split__content { order: 0; }
  }
</style>
