---
import Minimal from '../layouts/Minimal.astro';
import SignupForm from '../components/SignupForm.astro';

const photos = [
  { file: 'gallery-event.jpg', label: 'Club events', alt: 'Presentatie tijdens een Club Vanguard event op Kasteel Maurick' },
  { file: 'gallery-dinner.jpg', label: 'Dinners', alt: 'Clubdiner met Vanguard-leden' },
  { file: 'gallery-activity.jpg', label: 'Activiteiten', alt: 'Avondborrel tijdens de Faro trip' },
];
---
<Minimal
  title="Blijf op de hoogte · Club Vanguard"
  description="Eén korte mail per week over de events, dinners en activiteiten van Club Vanguard. Als eerste horen wanneer er plekken vrijkomen."
>
  <section class="section join-hero">
    <div class="container join-hero__grid">
      <div class="join-hero__content">
        <p class="eyebrow">Club Vanguard</p>
        <h1 class="join-hero__title">Mis het volgende <em>Vanguard-moment</em> niet.</h1>
        <p class="join-hero__text">
          Eén korte mail per week. Verhalen vanuit leden, behind the scenes
          en announcements over aankomende meetups.
        </p>
        <ul class="join-hero__list">
          <li>Wees als een van de eersten bij onze meetups</li>
          <li>Raak geïnspireerd door onze leden</li>
          <li>Hoor als eerste wanneer er plekken vrijkomen voor een dinner</li>
        </ul>
      </div>
      <div class="join-hero__card">
        <p class="join-hero__card-title">Zet je op de lijst</p>
        <SignupForm context="join" id="join-hero" stacked={true} />
      </div>
    </div>
  </section>

  <section class="join-photos" aria-label="Zo ziet een Vanguard-moment eruit">
    <div class="container join-photos__grid">
      {photos.map((p) => (
        <figure class="join-photos__item">
          <img
            src={`/images/${p.file}`}
            alt={p.alt}
            class="site-photo join-photos__img"
            loading="lazy"
            width="1050"
            height="1400"
          />
          <figcaption class="join-photos__caption">{p.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>

</Minimal>

<style>
  .join-hero {
    padding-bottom: clamp(3rem, 7vh, 4.5rem);
  }
  .join-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .join-hero__title {
    font-size: var(--text-2xl);
    max-width: 16ch;
  }
  .join-hero__title em {
    font-style: italic;
    color: var(--brass-soft);
  }
  .join-hero__text {
    margin-top: 1.3rem;
    color: var(--ivory-dim);
    max-width: 44ch;
  }
  .join-hero__list {
    list-style: none;
    margin-top: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 44ch;
  }
  .join-hero__list li {
    position: relative;
    padding-left: 1.6rem;
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .join-hero__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.8rem;
    height: 1px;
    background: var(--brass);
  }
  .join-hero__card {
    background: var(--navy-soft);
    border: 1px solid var(--line-navy);
    border-radius: 6px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .join-hero__card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: 1.1rem;
  }

  .join-photos {
    padding-bottom: var(--space-section);
  }
  .join-photos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .join-photos__item {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line-navy);
    border-radius: 6px;
  }
  .join-photos__img { min-height: 0; }
  .join-photos__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1rem 0.9rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ivory);
    background: linear-gradient(to top, rgba(8, 18, 32, 0.85), rgba(8, 18, 32, 0));
  }


  @media (max-width: 900px) {
    .join-hero__grid { grid-template-columns: 1fr; }
    .join-hero__title { max-width: none; }
  }
  @media (max-width: 640px) {
    .join-photos__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .join-photos__caption {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      padding: 1.6rem 0.5rem 0.6rem;
    }
  }
</style>
