---
/**
 * Vindbaarheidspagina: "ondernemersclub den bosch" / "ondernemersclub brabant" / "ondernemersnetwerk brabant".
 * Eerlijk: Den Bosch is het vestigingsadres, geen clubhuis. De club is landelijk.
 */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Agenda from '../components/Agenda.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { denBoschFaqs } from '../data/faq-seo';
import { faqSchema } from '../data/schema';
import { upcomingAgenda } from '../data/agenda';

const items = upcomingAgenda(3);
---
<Base
  title="Ondernemersclub uit Den Bosch, actief in heel Nederland · Club Vanguard"
  description="Club Vanguard is een landelijke ondernemersclub voor e-commerce, retail en AI, met Den Bosch als vestigingsadres. Events door het hele land, meestal rond Utrecht. Lid worden begint met een gesprek."
  image="/images/event-maurick.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema(denBoschFaqs))} />
  </Fragment>

  <section class="section seo-hero">
    <div class="container container--narrow">
      <p class="eyebrow">Ondernemersclub Den Bosch · Brabant · Nederland</p>
      <h1 class="seo-hero__title">Ondernemersclub uit Den Bosch, <em>actief in heel Nederland.</em></h1>
      <p class="lead seo-hero__lead">
        Club Vanguard is een landelijke club met Den Bosch als vestigingsadres. We komen samen door het hele
        land, meestal rond Utrecht, en één keer per jaar in het buitenland.
      </p>
      <a href="/aanvragen/" class="btn btn--solid">Start je aanvraag</a>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container split">
      <div class="split__content">
        <h2 class="section-title">Een club is wie er aan tafel zit.</h2>
        <p class="seo-text">
          Een mooie locatie helpt, maar de beleving maken de mensen. Ruim vijftig ondernemers, de meeste
          tussen de 20 en 38, uit e‑commerce, retail, AI en software. Twaalf keer per jaar komen we samen.
        </p>
      </div>
      <img src="/images/event-maurick.jpg" alt="Kasteel Maurick in Vught, locatie van een Club Vanguard-event" class="site-photo split__photo" width="600" height="450" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="container split split--reverse">
      <img src="/images/maurick-zaal.jpg" alt="Leden van Club Vanguard in gesprek tijdens een clubdag" class="site-photo split__photo" width="600" height="450" loading="lazy" />
      <div class="split__content">
        <h2 class="section-title">Wie je er tegenkomt.</h2>
        <p class="seo-text seo-text--dim">
          Merkeigenaren op bol, Amazon en Shopify, en in retail, van Kaufland tot Decathlon. Oprichters van
          agencies. Bouwers van AI-tools. Omzetten van een paar ton tot meerdere miljoenen. Leden uit heel
          Nederland, en een paar in Spanje.
        </p>
      </div>
    </div>
  </section>

  <Agenda items={items} light eyebrow="Agenda" title="Komende momenten" showJoinLink />

  <section class="section">
    <div class="container container--narrow">
      <h2 class="section-title">Lid worden begint met een gesprek.</h2>
      <p class="seo-text seo-text--dim">
        Je stuurt een aanvraag in, daarna bellen we een halfuur. Eerst meekijken kan als gast bij een club
        event. Twijfel je? Lees <a href="/welke-ondernemersclub-past-bij-jou/">welke ondernemersclub bij jou past</a>.
      </p>
    </div>
  </section>

  <Faq items={denBoschFaqs} light eyebrow="Veelgestelde vragen" title="Over Vanguard en Den Bosch" />
  <ClosingCta />
</Base>

<style>
  .seo-hero { background: var(--navy-deep); }
  .seo-hero__title { font-size: var(--text-display); line-height: 1.08; max-width: 18ch; }
  .seo-hero__title em { font-style: italic; color: var(--brass-soft); }
  .seo-hero__lead { margin: 1.6rem 0 2.2rem; max-width: 60ch; }
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .split--reverse .split__content { order: 1; }
  .split__photo { width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--line-ivory); object-fit: cover; aspect-ratio: 4 / 3; }
  .seo-text { margin-top: 1.4rem; color: var(--ink-dim); line-height: 1.7; font-size: var(--text-base); max-width: 58ch; }
  .seo-text--dim { color: var(--ivory-dim); }
  .seo-text a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .split { grid-template-columns: 1fr; }
    .split--reverse .split__content { order: 0; }
  }
</style>
