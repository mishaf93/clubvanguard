---
import Base from '../layouts/Base.astro';
import { eventCategories, pastEvents } from '../data/events.ts';
import { upcomingAgenda } from '../data/agenda';
import Agenda from '../components/Agenda.astro';
import SignupForm from '../components/SignupForm.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import ClosingCta from '../components/ClosingCta.astro';

const agendaItems = upcomingAgenda(3);
const heroImage = '/images/gallery-2.jpg';

const meetupBenefits = [
  'Eerlijke gesprekken met mensen die het spel begrijpen',
  'Gecureerde introducties gebaseerd op relevantie en vertrouwen',
  'Lessen van andere e-commerce ondernemers en operators',
  'Offline momenten die echte herinneringen creëren',
  'Toegang tot ruimtes waar je normaal gesproken niet zomaar binnen zou gaan',
  'Een groep mensen die samen willen groeien en winnen',
];
---
<Base
  title="Meetups · Club Vanguard"
  description="Offline momenten voor e-commerce & AI-ondernemers die daadwerkelijk aan het bouwen zijn. Bekijk aankomende events, diners, activiteiten en internationale trips."
>
  <Agenda
    items={agendaItems}
    eyebrow="Agenda"
    title="De komende drie maanden"
    lead="Dinners zijn klein en bewust beperkt. Club events zijn groter en staan open voor iedereen op de lijst."
    showJoinLink={false}
  />


  <section class="section section--ivory past" aria-labelledby="past-title">
    <div class="container">
      <p class="eyebrow">Terugblik</p>
      <h2 id="past-title" class="section-title">Vorige editie</h2>
      <div class="past__list">
        {pastEvents.map((ev) => (
          <article class="past__card">
            <img
              src={`/images/${ev.photo}`}
              alt={`${ev.title}, ${ev.location}`}
              class="site-photo past__photo"
              loading="lazy"
              width="1600"
              height="1067"
            />
            <div class="past__body">
              <p class="past__badge">Afgelopen</p>
              <h3 class="past__title">{ev.title}</h3>
              <p class="past__meta">{ev.dateLabel} · {ev.location}</p>
              <p class="past__text">{ev.summary}</p>
              <a href={ev.detailUrl} class="past__link">Bekijk hoe het was →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section next" id="aanmelden" aria-labelledby="next-title">
    <div class="container next__grid">
      <div>
        <p class="eyebrow">De volgende editie</p>
        <h2 id="next-title" class="section-title">Wil je er de volgende keer bij zijn?</h2>
        <p class="next__text">
          Zet je op de lijst. Eén korte mail per week, en je hoort als eerste
          wanneer de datum en de plekken van het volgende event bekend zijn.
        </p>
      </div>
      <div class="next__card">
        <SignupForm context="meetups" id="meetups-signup" stacked={true} />
      </div>
    </div>
  </section>

  <section class="section meetups-hero">
    <div class="container meetups-hero__grid">
      <div class="meetups-hero__content">
        <p class="eyebrow">Meetups & Gatherings</p>
        <h1 class="meetups-hero__title">
          Offline momenten voor mensen die <em>daadwerkelijk bouwen</em>
        </h1>
        <p class="meetups-hero__intro">
          Binnen onze meetups krijgen leden toegang tot gesprekken en relaties die
          moeilijk toevallig te creëren zijn.
        </p>
        <ul class="meetups-hero__list">
          {meetupBenefits.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <img
        src={heroImage}
        alt="Vanguard-leden buiten op Flora Batavia"
        class="site-photo meetups-hero__photo"
        width="1600"
        height="1200"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section section--ivory types">
    <div class="container">
      <p class="eyebrow">Wat je kunt verwachten</p>
      <div class="types__grid">
        {eventCategories.map((cat) => (
          <article class="types__card">
            <img
              src={`/images/${cat.photo}`}
              alt={cat.title}
              class:list={['site-photo', 'types__photo', cat.flip && 'types__photo--flip']}
              loading="lazy"
              width="1200"
              height="750"
            />
            <h3 class="types__title">{cat.title}</h3>
            <p class="types__text">{cat.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PhotoGallery />

  <section class="section section--ivory offline">
    <div class="container container--narrow offline__inner">
      <p class="eyebrow">Waarom offline</p>
      <h2 class="section-title">In een digitale wereld zijn echte ontmoetingen belangrijker dan ooit</h2>
      <p class="offline__text">
        AI, automatisering en thuiswerken veranderen hoe bedrijven opereren.
        Maar hoe digitaler de wereld wordt, hoe waardevoller echt vertrouwen wordt.
        De juiste mensen om je heen kunnen veranderen hoe je denkt, wat je bouwt
        en welke deuren zich hierna openen.
      </p>
    </div>
  </section>

  <ClosingCta />
</Base>

<style>
  .past__list {
    margin-top: 2rem;
  }
  .past__card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    border: 1px solid var(--line-ivory);
    border-radius: 6px;
    overflow: hidden;
  }
  .past__photo {
    aspect-ratio: 4 / 3;
    min-height: 0;
    filter: saturate(0.85);
  }
  .past__body { padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 3vw, 2.25rem) 0; }
  .past__badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
    border: 1px solid var(--line-ivory);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }
  .past__title {
    font-size: var(--text-xl);
    margin-top: 0.9rem;
  }
  .past__meta {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--ink-dim);
  }
  .past__text {
    margin-top: 1rem;
    color: var(--ink-dim);
    line-height: 1.7;
    max-width: 46ch;
  }
  .past__link {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brass);
    text-decoration: none;
  }
  .past__link:hover { text-decoration: underline; }

  .next {
    background: var(--navy-deep);
    border-top: 1px solid var(--line-navy);
    border-bottom: 1px solid var(--line-navy);
  }
  .next__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .next__text {
    margin-top: 1.2rem;
    color: var(--ivory-dim);
    max-width: 44ch;
  }
  .next__card {
    background: var(--navy-soft);
    border: 1px solid var(--line-navy);
    border-radius: 6px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .meetups-hero {
    padding-bottom: clamp(2rem, 5vh, 3rem);
  }
  .meetups-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .meetups-hero__title {
    font-size: var(--text-section-lg);
    max-width: 20ch;
  }
  .meetups-hero__title em {
    font-style: italic;
    color: var(--brass-soft);
  }
  .meetups-hero__intro {
    margin-top: 1.2rem;
    color: var(--ivory-dim);
    font-size: var(--text-base);
    line-height: 1.65;
    max-width: 46ch;
  }
  .meetups-hero__list {
    list-style: none;
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 48ch;
  }
  .meetups-hero__list li {
    position: relative;
    padding-left: 1.75rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ivory);
  }
  .meetups-hero__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.05em;
    width: 1.15rem;
    height: 1.15rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(185, 148, 90, 0.18);
    color: var(--brass);
    font-size: 0.65rem;
    font-weight: 700;
  }
  .meetups-hero__photo {
    width: 100%;
    max-width: 520px;
    justify-self: end;
    aspect-ratio: 4 / 3;
    min-height: 0;
    border: 1px solid var(--line-navy);
    border-radius: 6px;
    object-position: center 40%;
  }

  .section.section--ivory.types {
    padding-bottom: clamp(7rem, 18vh, 11rem);
  }
  .types__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    margin-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .types__card {
    display: flex;
    flex-direction: column;
  }
  .types__photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    min-height: 0;
    object-fit: cover;
    border: 1px solid var(--line-ivory);
    border-radius: 6px;
  }
  .types__photo--flip {
    transform: scaleX(-1);
  }
  .types__title {
    font-size: var(--text-lg);
    margin-top: 1.85rem;
  }
  .types__text {
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
    font-size: var(--text-sm);
    color: var(--ink-dim);
    line-height: 1.7;
  }

  .offline__inner { text-align: center; }
  .offline__inner .section-title { margin-inline: auto; }
  .offline__text {
    margin-top: 1.4rem;
    color: var(--ink-dim);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .past__card { grid-template-columns: 1fr; }
    .past__body { padding: 1.25rem; }
    .next__grid { grid-template-columns: 1fr; }
    .meetups-hero__grid { grid-template-columns: 1fr; }
    .meetups-hero__photo {
      max-width: none;
      justify-self: stretch;
    }
    .types__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .types__grid { grid-template-columns: 1fr; }
  }
</style>
