---
const steps = [
  {
    tag: 'Stap 1',
    title: 'Dien je aanvraag in',
    text: 'Vertel kort wie je bent en wat je bouwt. We beoordelen elke aanvraag persoonlijk.',
  },
  {
    tag: 'Stap 2',
    title: 'Kennismakingsgesprek',
    text: 'Past het van twee kanten? In een open gesprek leren we je kennen en kijken we of Vanguard bij je past.',
  },
  {
    tag: 'Stap 3',
    title: 'Besluit binnen 1–2 dagen',
    text: 'Word je toegelaten, dan krijg je direct toegang tot de community, de app en de Insider.',
  },
];
---
<section class="section how">
  <div class="container">
    <p class="eyebrow">Hoe het werkt</p>
    <h2 class="section-title">Van aanvraag tot onderdeel van Vanguard</h2>

    <ol class="how__track">
      {steps.map((s) => (
        <li class="how__step">
          <span class="how__dot" aria-hidden="true"></span>
          <span class="how__tag">{s.tag}</span>
          <h3 class="how__title">{s.title}</h3>
          <p class="how__text">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="how__cta">
      <a href="/aanvragen/" class="btn btn--solid">Start je aanvraag</a>
    </div>
  </div>
</section>

<style>
  .how__track {
    list-style: none;
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 1.5rem;
    position: relative;
  }
  .how__track::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--brass);
  }
  .how__step {
    position: relative;
    padding-top: 1.6rem;
  }
  .how__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--navy);
    border: 2px solid var(--brass);
  }
  .how__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .how__title {
    font-size: var(--text-lg);
    margin-top: 0.5rem;
  }
  .how__text {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--ivory-dim);
    line-height: 1.7;
  }
  .how__cta {
    margin-top: 3rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .how__track { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .how__track {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-left: 1.6rem;
    }
    .how__track::before {
      top: 0;
      bottom: 0;
      left: 5px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .how__step { padding-top: 0; }
    .how__dot { left: -1.6rem; top: 6px; }
  }
</style>
