---
const stats = [
  { value: '50+', label: 'Geselecteerde leden' },
  { value: '8,8', label: 'Gem. beoordeling' },
  { value: '6', label: 'Events per jaar' },
  { value: '1', label: 'Internationale trip' },
];
---
<section class="stats" aria-label="Vanguard in cijfers">
  <div class="container stats__grid">
    {stats.map((s) => (
      <div class="stats__item">
        <span class="stats__value">{s.value}</span>
        <span class="stats__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    border-block: 1px solid var(--line-navy);
    padding-block: 2.4rem;
    background: var(--navy-deep);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
    text-align: center;
  }
  .stats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .stats__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--brass);
    line-height: 1;
  }
  .stats__label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ivory-dim);
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .stats__grid { grid-template-columns: repeat(2, 1fr); }
    .stats__label { white-space: normal; }
  }
</style>
