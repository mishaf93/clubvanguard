---
import type { VanguardEvent } from '../data/events.ts';

interface Props {
  event: VanguardEvent;
  eyebrow?: string;
  showMeetupsLink?: boolean;
}

const { event, eyebrow = 'Volgend event', showMeetupsLink = true } = Astro.props;
const eventDate = new Date(event.date);
const day = eventDate.getDate().toString().padStart(2, '0');
const month = eventDate.toLocaleDateString('nl-NL', { month: 'short' }).toUpperCase();
---
<section class="section upcoming" aria-labelledby="upcoming-event-title">
  <div class="container">
    <div class="upcoming__grid">
      <img
        src={`/images/${event.photo}`}
        alt={`${event.title} op ${event.location}`}
        class="site-photo upcoming__photo"
        loading="lazy"
        width="1600"
        height="1200"
      />
      <div class="upcoming__content">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="upcoming-event-title" class="section-title">{event.title}</h2>
        <p class="upcoming__text">{event.description}</p>
        <dl class="upcoming__meta">
          <div>
            <dt>Datum</dt>
            <dd>{event.dateLabel}</dd>
          </div>
          <div>
            <dt>Tijd</dt>
            <dd>{event.time}</dd>
          </div>
          <div>
            <dt>Locatie</dt>
            <dd>{event.location}</dd>
          </div>
        </dl>
        <div class="upcoming__footer">
          <div class="upcoming__date" aria-hidden="true">
            <span class="upcoming__day">{day}</span>
            <span class="upcoming__month">{month}</span>
          </div>
          <div class="upcoming__actions">
            {event.detailUrl ? (
              <a href={event.detailUrl} class="btn btn--solid">Bekijk dit event</a>
            ) : (
              <a href={event.signupUrl} class="btn btn--solid" target="_blank" rel="noopener">Meld je aan</a>
            )}
            {showMeetupsLink && (
              <a href="/meetups/" class="btn btn--ghost">Bekijk alle events</a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .upcoming__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .upcoming__photo {
    aspect-ratio: 4 / 3;
    min-height: 0;
    border: 1px solid var(--line-navy);
    border-radius: 6px;
  }
  .upcoming__text {
    margin-top: 1rem;
    color: var(--ivory-dim);
    max-width: 48ch;
  }
  .upcoming__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin-top: 1.8rem;
  }
  .upcoming__meta dt {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .upcoming__meta dd {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
  }
  .upcoming__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
    margin-top: 2rem;
  }
  .upcoming__date {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line-navy);
    border-radius: 6px;
    background: var(--navy-soft);
  }
  .upcoming__day {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--brass);
    line-height: 1;
  }
  .upcoming__month {
    margin-top: 0.35rem;
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    color: var(--ivory-dim);
  }
  .upcoming__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .upcoming__grid { grid-template-columns: 1fr; }
  }
</style>
