---
/**
 * Leespagina voor juridische teksten (voorwaarden, privacy).
 * Ivory achtergrond, smalle kolom, genummerde artikelen via <h2>.
 */
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  /** Bv. "Versie 1.0 · 12 oktober 2026" */
  meta?: string;
}

const { title, description, eyebrow, heading, meta } = Astro.props;
---
<Base title={title} description={description}>
  <section class="section section--ivory legal">
    <div class="container container--narrow">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="legal__title">{heading}</h1>
      {meta && <p class="legal__meta">{meta}</p>}
      <div class="legal__body">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .legal__title { font-size: var(--text-2xl); }
  .legal__meta {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--ink-dim);
  }
  .legal__body {
    margin-top: 3rem;
    color: var(--ink);
  }
  .legal__body h2 {
    font-size: var(--text-lg);
    margin-top: 2.75rem;
    margin-bottom: 0.9rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-ivory);
  }
  .legal__body h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .legal__body h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    margin-top: 1.6rem;
    margin-bottom: 0.4rem;
  }
  .legal__body p { margin-bottom: 0.9rem; }
  .legal__body p.legal__intro { color: var(--ink-dim); }
  .legal__body ol,
  .legal__body ul {
    padding-left: 1.4rem;
    margin-bottom: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .legal__body li::marker { color: var(--brass); }
  .legal__body a { color: var(--brass); text-underline-offset: 3px; }
  .legal__body a:hover { color: var(--ink); }
  .legal__body strong { font-weight: 600; }
  .legal__body dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.9rem;
    font-size: var(--text-sm);
  }
  .legal__body dt { color: var(--ink-dim); }
  .legal__body dd { margin: 0; }
  .legal__body .legal__note {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line-ivory);
    background: rgba(255, 255, 255, 0.45);
    font-size: var(--text-sm);
    color: var(--ink-dim);
  }
  @media (max-width: 520px) {
    .legal__body dl { grid-template-columns: 1fr; gap: 0.15rem; }
    .legal__body dt { margin-top: 0.6rem; }
  }
</style>
