---
// Hero video: PUBLIC_HERO_VIDEO overschrijft pad · poster via PUBLIC_HERO_IMAGE
const heroVideo = import.meta.env.PUBLIC_HERO_VIDEO ?? '/videos/hero-loop.mp4';
const heroPoster = import.meta.env.PUBLIC_HERO_IMAGE ?? '/images/pillars-events.jpg';
---
<section class="hero">
  <video
    class="hero__media"
    src={heroVideo}
    poster={heroPoster}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
  <img
    src={heroPoster}
    alt=""
    class="hero__media hero__media--fallback"
    width="2400"
    height="1000"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="container hero__content">
    <h1 class="hero__title">Zuivere ondernemers op niveau.<br /><em>Eerlijke gesprekken.</em></h1>
    <p class="lead hero__lead">
      Dé community voor e-commerce & AI-ondernemers die
      waarde hechten aan eerlijke gesprekken, hoge standaarden en echte relaties.
    </p>
    <div class="hero__actions">
      <a href="/aanvragen/" class="btn btn--solid">Aanvraag indienen</a>
      <a href="/meetups/" class="btn btn--ghost">Bekijk events</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 780px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__media--fallback {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero video.hero__media {
      display: none;
    }
    .hero__media--fallback {
      display: block;
    }
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 18, 32, 0.58);
  }
  .hero__content {
    position: relative;
    padding-block: clamp(3.5rem, 9vh, 6rem);
  }
  .hero__title {
    font-size: var(--text-hero);
    max-width: 16ch;
  }
  .hero__title em {
    font-style: italic;
    color: var(--brass-soft);
  }
  .hero__lead {
    margin-top: 1.4rem;
    color: var(--ivory-dim);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }
</style>
