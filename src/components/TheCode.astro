---
const values = [
  {
    title: 'Integriteit',
    text: 'We doen wat we zeggen. We zeggen wat we doen.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    title: 'No Ego',
    text: 'We laten ons ego buiten. We willen samen winnen.',
    iconMask: '/images/icon-no-ego-mask.png',
    iconLarge: true,
  },
  {
    title: 'Verbinding',
    text: 'Echte relaties boven oppervlakkige netwerken.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'Onvoorwaardelijk delen',
    text: "Geen 'geven en nemen', maar geven en ontvangen.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>`,
  },
];
---
<section class="section section--ivory code">
  <div class="container">
    <p class="eyebrow">De Code</p>
    <h2 class="code__heading">Gebouwd op vertrouwen. Gehouden aan normen.</h2>
    <div class="code__grid">
      {values.map((v) => (
        <article class="code__card">
          <div class:list={['code__icon', v.iconLarge && 'code__icon--lg']}>
            {v.iconMask ? (
              <span class="code__icon-mask" aria-hidden="true"></span>
            ) : (
              <Fragment set:html={v.icon} />
            )}
          </div>
          <h3 class="code__title">{v.title}</h3>
          <p class="code__text">{v.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .code__heading {
    font-size: var(--text-section);
    max-width: 30ch;
  }
  .code__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
  .code__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .code__icon {
    color: var(--brass);
    margin-bottom: 1.2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 36px;
  }
  .code__icon--lg {
    min-height: 44px;
    margin-bottom: 1rem;
  }
  .code__icon-mask {
    display: block;
    width: 44px;
    height: 44px;
    background-color: var(--brass);
    -webkit-mask-image: url('/images/icon-no-ego-mask.png');
    mask-image: url('/images/icon-no-ego-mask.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
  .code__icon--lg :global(svg) {
    width: 44px;
    height: 44px;
  }
  .code__title {
    font-size: clamp(1.08rem, 1.55vw, 1.32rem);
    white-space: nowrap;
    max-width: 100%;
  }
  .code__text {
    margin-top: 0.75rem;
    font-size: var(--text-base);
    color: var(--ink-dim);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .code__grid { grid-template-columns: repeat(2, 1fr); }
    .code__title {
      font-size: clamp(1.05rem, 2.2vw, 1.28rem);
    }
  }
  @media (max-width: 540px) {
    .code__grid { grid-template-columns: 1fr; }
    .code__title {
      white-space: normal;
      font-size: var(--text-lg);
    }
  }
</style>
